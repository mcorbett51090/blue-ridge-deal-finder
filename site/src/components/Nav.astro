---
/**
 * Sticky topbar. Single copy — the reference maintains two (Nav.astro plus an
 * inline duplicate in index.astro) and documents the drift that caused
 * (claims-D claim 13). Not repeating that.
 */
import { withBase } from '../lib/nav';
import { site } from '../config/site';
import FreshnessBadge from './FreshnessBadge.astro';

interface Props {
  /** Current app-absolute path, for aria-current. */
  path?: string;
}
const { path = '' } = Astro.props;
const links = [
  { href: '/', label: 'Map' },
  { href: '/status/', label: 'Status' },
  { href: '/about/', label: 'About' },
];
---

<header class="topbar">
  <a class="topbar__brand" href={withBase('/')}>
    <svg class="topbar__mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
      <!-- Three ridgelines receding into haze. Abstract brand art, never a
           depiction of a real place — and deliberately NOT a map pin, which
           would imply a precision this data does not have. -->
      <path d="M1 25 L9 12 L15 20 L21 9 L31 25 Z" fill="currentColor" opacity="0.85"></path>
      <path d="M1 27 L7 19 L13 25 L19 16 L31 27 Z" fill="currentColor" opacity="0.45"></path>
    </svg>
    <span class="topbar__name">{site.name}</span>
  </a>

  <nav class="topbar__nav" aria-label="Primary">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={withBase(l.href)} aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="topbar__ctrls">
    <FreshnessBadge />
    <button
      class="topbar__cb"
      type="button"
      data-cb-toggle
      aria-pressed="false"
      title="Colour-blind-safe palette"
    >
      <span class="visually-hidden">Colour-blind-safe palette</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M12 4 a8 8 0 0 1 0 16 z" fill="currentColor"></path>
      </svg>
    </button>
    <button class="topbar__theme" type="button" data-theme-toggle title="Switch theme">
      <span class="visually-hidden">Switch between the Ridge and Hollow themes</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M12 3 a9 9 0 1 0 9 9 a7 7 0 0 1-9-9 z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Theme + colour-blind toggles. Both persist to localStorage and dispatch a
  // custom event that the map listens for — the map re-themes by calling
  // setPaintProperty on the existing style, never setStyle() (claims-D claim 23).
  (() => {
    const root = document.documentElement;
    const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const cbBtn = document.querySelector<HTMLButtonElement>('[data-cb-toggle]');

    themeBtn?.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'hollow' ? 'ridge' : 'hollow';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('brdf-theme', next);
      } catch {
        /* private mode — the theme still applies for this page view */
      }
      window.dispatchEvent(new CustomEvent('brdf:themechange', { detail: { theme: next } }));
    });

    if (cbBtn) {
      cbBtn.setAttribute('aria-pressed', String(root.getAttribute('data-cb') === 'on'));
      cbBtn.addEventListener('click', () => {
        const on = root.getAttribute('data-cb') !== 'on';
        if (on) root.setAttribute('data-cb', 'on');
        else root.removeAttribute('data-cb');
        cbBtn.setAttribute('aria-pressed', String(on));
        try {
          localStorage.setItem('brdf-cb', on ? 'on' : 'off');
        } catch {
          /* private mode */
        }
        window.dispatchEvent(new CustomEvent('brdf:cbchange', { detail: { on } }));
      });
    }
  })();
</script>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: var(--nav-h);
    padding-inline: clamp(0.75rem, 2.5vw, 1.5rem);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    backdrop-filter: blur(14px) saturate(1.05);
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
    border-bottom: var(--hairline) solid var(--rule);
  }
  .topbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    color: var(--accent);
    flex-shrink: 0;
  }
  .topbar__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .topbar__nav ul {
    display: flex;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .topbar__nav a {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.4em 0.2em;
  }
  .topbar__nav a:hover {
    color: var(--accent);
  }
  .topbar__nav a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .topbar__ctrls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .topbar__theme,
  .topbar__cb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: var(--hairline) solid var(--rule);
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
  }
  .topbar__theme:hover,
  .topbar__cb:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .topbar__cb[aria-pressed='true'] {
    color: var(--accent-on);
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 860px) {
    .topbar__name {
      display: none;
    }
    .topbar__nav a {
      font-size: var(--step--2);
    }
  }
</style>
