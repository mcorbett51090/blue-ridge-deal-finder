---
/**
 * COUNTY-LEVEL SALE NOTICES.
 *
 * ⛔ These are deliberately NOT deal cards. The property identity lives in
 * scanned PDFs with no text layer, so no notice here can be joined to a parcel.
 * Rendering one as a listing would attach a real, dated foreclosure sale to a
 * guessed address — a false claim about somewhere specific. A notice with no
 * parcel is a true claim about a county, and that is what this shows.
 *
 * Placed above the lanes because a sale can be TOMORROW and a list you scroll
 * past is not a notice.
 */
import notices from '../data/notices.json';

/** ⛔ The published NOTICE CONTRACT — and `title` is deliberately not in it.
 *
 *  This component used to render `{n.title}`: free text lifted verbatim from a
 *  county website, straight onto the homepage. The fail-closed field allowlist
 *  never ran on notices (`project()` was called once, for 'listing'), so nothing
 *  checked what was in that string. Today's three read "Tax foreclosure Sale
 *  August 20, 2026 at 10:00 a.m." — harmless, and inconsistently cased, which is
 *  the tell that they were verbatim.
 *
 *  The notice sources queued next are Georgia legal-organ advertisements, whose
 *  titles conventionally read "SALE UNDER POWER …" followed by the DEBTOR'S
 *  NAME. `verify-no-pii.mjs` would not have caught it: it matches field names,
 *  and its value-level screen is scoped to the evidence contract.
 *
 *  So the label below is OURS, derived from a closed-vocabulary `kind`. The
 *  county's words are used to classify and then discarded. */
type NoticeKind = 'tax-foreclosure' | 'sale-under-power' | 'sheriff-sale' | 'county-notice';

type Notice = {
  notice_id: string;
  kind: NoticeKind;
  source_url: string;
  county: string;
  state: string;
  sale_date: string | null;
};

/** ⛔ These differ in what a reader would DO. A tax foreclosure is a county
 *  auction with an upset-bid window; a sale under power is a private,
 *  lender-driven sale with none. Labelling one as the other sends someone to the
 *  wrong place on the wrong day with the wrong money. */
const KIND_LABEL: Record<NoticeKind, string> = {
  'tax-foreclosure': 'Tax foreclosure sale',
  'sale-under-power': 'Sale under power (lender-initiated)',
  'sheriff-sale': "Sheriff's sale",
  'county-notice': 'County notice — the mechanism could not be identified from the posting',
};

const all = (notices as Notice[]) ?? [];
const today = new Date().toISOString().slice(0, 10);
// Past sales are history, not opportunities — but "history" still means SHOWN,
// clearly labelled, not silently dropped. A notice that vanishes with no trace
// the moment its date passes reads as "nothing happened here", when a real,
// dated sale did happen. It moves to the archive list below instead.
// An unknown date is KEPT in the live list — dropping it would silently hide a
// real notice we merely failed to parse a date from.
const live = all.filter((n) => n.sale_date === null || n.sale_date >= today);
const past = all
  .filter((n) => n.sale_date !== null && n.sale_date < today)
  .sort((a, b) => (b.sale_date as string).localeCompare(a.sale_date as string));

const days = (d: string | null): number | null => {
  if (!d) return null;
  return Math.round((Date.parse(d) - Date.parse(today)) / 86_400_000);
};
---

{
  live.length > 0 && (
    <section class="notices" aria-labelledby="notices-h">
      <h2 class="notices__h" id="notices-h">
        Upcoming foreclosure sales
        <span class="notices__n num">{live.length}</span>
      </h2>
      <p class="notices__blurb">
        Real, dated sale events published by the county. They are <strong>not</strong> matched to a
        parcel: the county publishes the property details as scanned images with no readable text,
        so we can tell you the sale is happening and link you to the notice, but not which parcel it
        is. Open the notice to see the property.
      </p>
      <ul class="notices__list" data-notices-live>
        {live.map((n) => {
          const d = days(n.sale_date);
          return (
            <li class="notice" data-notice data-sale-date={n.sale_date ?? ''}>
              <span class={`notice__when${d !== null && d <= 1 ? ' notice__when--soon' : ''}`} data-notice-when>
                {n.sale_date === null
                  ? 'date not stated'
                  : d === 0
                    ? 'TODAY'
                    : d === 1
                      ? 'TOMORROW'
                      : `in ${d} days`}
              </span>
              <span class="notice__body">
                <strong>{n.county} County, {n.state}</strong> — {KIND_LABEL[n.kind] ?? KIND_LABEL['county-notice']}
                {n.sale_date && <> on {n.sale_date}</>}
                <br />
                <a href={n.source_url} rel="noopener nofollow external" target="_blank">
                  County notice ↗
                </a>
              </span>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

{
  /* ARCHIVE — a sale whose date has passed is history, not an invitation, and
     the whole point of this block is that it must never be mistaken for the
     section above. Collapsed by default (closed <details>, no JS required),
     visually muted, and every date is stated as PASSED rather than as a
     countdown. */
  past.length > 0 && (
    <details class="notices notices--archive" data-notices-archive>
      <summary class="notices__h notices__sum">
        Past sale notices <span class="notices__n num">{past.length}</span>
      </summary>
      <p class="notices__blurb">
        These sale dates have passed. Kept here for reference and provenance, not because the sale
        is still happening — a notice does not disappear from this project just because its date did.
      </p>
      <ul class="notices__list" data-notices-past>
        {past.map((n) => (
          <li class="notice notice--past" data-notice data-sale-date={n.sale_date ?? ''}>
            <span class="notice__when notice__when--past" data-notice-when>Sale date passed</span>
            <span class="notice__body">
              <strong>{n.county} County, {n.state}</strong> — {KIND_LABEL[n.kind] ?? KIND_LABEL['county-notice']}
              {n.sale_date && <> — was {n.sale_date}</>}
              <br />
              <a href={n.source_url} rel="noopener nofollow external" target="_blank">
                County notice ↗
              </a>
            </span>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  // Re-verify against the VISITOR'S clock, not the build's. A static page
  // built on day 0 and viewed on day 20 would otherwise keep telling a reader
  // "in 3 days" about a sale that already happened three weeks ago — the exact
  // "reads as current when it is not" failure this component exists to avoid.
  // Cheap to redo client-side: at most a handful of notices exist at once.
  (() => {
    const liveList = document.querySelector<HTMLUListElement>('[data-notices-live]');
    const archiveList = document.querySelector<HTMLUListElement>('[data-notices-past]');
    const archiveDetails = document.querySelector<HTMLDetailsElement>('[data-notices-archive]');
    const items = Array.from(document.querySelectorAll<HTMLLIElement>('[data-notice]'));
    if (items.length === 0) return;

    const todayIso = new Date().toISOString().slice(0, 10);
    for (const li of items) {
      const saleDate = li.dataset.saleDate || '';
      if (saleDate === '' || saleDate >= todayIso) continue; // still live or undated — leave as rendered
      if (li.classList.contains('notice--past')) continue; // already archived server-side
      // A live-rendered notice whose date has since passed: move it to the
      // archive list live, in the browser, rather than leaving it to read as
      // current until the next rebuild.
      li.classList.add('notice--past');
      const whenEl = li.querySelector<HTMLElement>('[data-notice-when]');
      if (whenEl) {
        whenEl.textContent = 'Sale date passed';
        whenEl.classList.remove('notice__when--soon');
        whenEl.classList.add('notice__when--past');
      }
      if (archiveList) {
        archiveList.appendChild(li);
        if (archiveDetails) archiveDetails.hidden = false;
      }
    }
    // The live section's own count and visibility need the same correction —
    // otherwise a heading reading "Upcoming foreclosure sales — 3" could sit
    // above a list that the loop above just emptied.
    if (liveList) {
      const remaining = liveList.querySelectorAll('[data-notice]').length;
      const section = liveList.closest('section');
      const countEl = section?.querySelector<HTMLElement>('.notices__n');
      if (countEl) countEl.textContent = String(remaining);
      if (section && remaining === 0) (section as HTMLElement).hidden = true;
    }
  })();
</script>

<style>
  .notices {
    border: 1px solid var(--rule, #cfd8d6);
    border-left: 3px solid var(--sig-distress, #a8663a);
    background: var(--surface, #fbfcfc);
    border-radius: 2px;
    padding: 1rem 1.15rem;
    margin: 0 0 1.25rem;
  }
  .notices__h {
    font-size: 1.05rem;
    margin: 0 0 .3rem;
    display: flex;
    align-items: baseline;
    gap: .5rem;
  }
  .notices__n {
    font-size: .85rem;
    color: var(--ink-3, #667575);
  }
  .notices__blurb {
    font-size: .87rem;
    color: var(--ink-2, #3d4a4b);
    margin: 0 0 .7rem;
    max-width: 68ch;
  }
  .notices__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .notice { display: grid; grid-template-columns: 7.5rem 1fr; gap: .75rem; font-size: .9rem; }
  .notice__when {
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    letter-spacing: .04em;
    font-size: .76rem;
    color: var(--ink-3, #667575);
    padding-top: .15rem;
  }
  .notice__when--soon { color: var(--sig-distress, #a8663a); font-weight: 600; }
  @media (max-width: 560px) {
    .notice { grid-template-columns: 1fr; gap: .1rem; }
  }

  /* --- Archive: visually the OPPOSITE of "upcoming and urgent" ------------- */
  .notices--archive {
    border-left-color: var(--ink-soft, #667575);
    background: var(--band, #eef1ee);
    opacity: 0.92;
  }
  .notices__sum {
    cursor: pointer;
    list-style: none;
  }
  .notices__sum::-webkit-details-marker {
    display: none;
  }
  .notices__sum::before {
    content: '▸';
    margin-right: 0.4em;
    color: var(--ink-soft, #667575);
  }
  .notices--archive[open] .notices__sum::before {
    content: '▾';
  }
  .notice--past {
    opacity: 0.8;
  }
  .notice--past .notice__body strong {
    color: var(--ink-soft, #667575);
  }
  .notice__when--past {
    color: var(--ink-soft, #667575) !important;
    font-weight: 600;
    font-style: italic;
  }
</style>
