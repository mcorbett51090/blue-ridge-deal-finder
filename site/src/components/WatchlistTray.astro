---
/**
 * The watchlist tray. Ported from SWC's TripTray.astro (claims-D claim 41) —
 * a fixed FAB with a badge that reveals only once non-empty, a slide-out panel,
 * Escape-to-close, light-dismiss, and a polite aria-live region — PLUS the
 * export path the reference does not have.
 *
 * Why the export path is not optional here (RT-5):
 *
 *   (a) WebKit's ITP deletes all script-writable storage after 7 days of Safari
 *       use without visiting the site. A tool you check weekly sits on that
 *       boundary; a 10-day trip silently erases everything you were evaluating.
 *   (b) The published candidate set is recomputed every run, so a weights change
 *       — or simply enough new candidates outranking a saved one — un-generates
 *       a saved property's detail page and leaves this tray holding a 404.
 *
 * (b) is why a row whose id is no longer in the payload renders as an explicit
 * "no longer scored" state, never as a dead link. The reference's "greyed =
 * unverified, not broken" treatment (claims-D claim 42), applied one level up.
 */
import { sorted } from '../lib/deals';
import { withBase } from '../lib/nav';

// The ids currently published. Inlined so the tray can tell "saved and still
// scored" from "saved but no longer in the payload" with no fetch.
const publishedIds = sorted.map((l) => l.id);
---

<div class="wl-tray" data-wl-tray hidden data-js-only>
  <button class="wl-fab" type="button" data-wl-open aria-expanded="false" aria-controls="wl-panel">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
      <path
        d="M12 21s-7.5-4.7-9.3-9A5.4 5.4 0 0 1 12 6.6 5.4 5.4 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9z"
        fill="currentColor"></path>
    </svg>
    <span>Watchlist</span>
    <span class="wl-fab__n num" data-wl-count>0</span>
  </button>

  <div class="wl-panel" id="wl-panel" hidden>
    <div class="wl-panel__head">
      <h2>Watchlist</h2>
      <button class="wl-x" type="button" data-wl-close aria-label="Close the watchlist">✕</button>
    </div>

    <p class="wl-nudge" data-wl-nudge hidden></p>

    <ul class="wl-list" data-wl-list></ul>

    <div class="wl-acts">
      <button class="btn btn--primary btn--sm" type="button" data-wl-export>Export JSON</button>
      <label class="btn btn--ghost btn--sm wl-import">
        Import
        <input type="file" accept="application/json,.json" data-wl-import hidden />
      </label>
      <button class="btn btn--ghost btn--sm" type="button" data-wl-clear>Clear watchlist</button>
    </div>
    <p class="wl-fine">
      This list lives only in this browser. It is never sent anywhere. Safari deletes site storage
      after 7 days without a visit — export it if it matters.
    </p>
  </div>

  <p class="wl-live visually-hidden" role="status" aria-live="polite" data-wl-live></p>
  <p class="wl-toast" data-wl-toast hidden></p>
</div>

<script
  is:inline
  type="application/json"
  id="brdf-watch-ctx"
  set:html={JSON.stringify({ publishedIds, dealBase: withBase('/deal/') })}
></script>

<script>
  import {
    getItems,
    remove,
    clear,
    toggle,
    count,
    buildExport,
    markExported,
    daysSinceExport,
    importJson,
    getNotes,
    CHANGE_EVENT,
  } from '../lib/watchlist';

  (() => {
    const trayEl = document.querySelector<HTMLElement>('[data-wl-tray]');
    if (!trayEl) return;
    // Narrow ONCE here: TS cannot see the null-check above from inside the
    // closures below, and `tray!` at each use would be four chances to be wrong.
    const tray: HTMLElement = trayEl;
    // Build-time context, read from a JSON block rather than a global — the
    // same mechanism the map uses, so there is one pattern to learn.
    const ctxEl = document.getElementById('brdf-watch-ctx');
    const ctx: { publishedIds: string[]; dealBase: string } = ctxEl
      ? JSON.parse(ctxEl.textContent || '{}')
      : { publishedIds: [], dealBase: '/deal/' };
    const published = new Set<string>(ctx.publishedIds || []);
    const dealBase = ctx.dealBase || '/deal/';

    const panel = tray.querySelector<HTMLElement>('#wl-panel')!;
    const openBtn = tray.querySelector<HTMLButtonElement>('[data-wl-open]')!;
    const closeBtn = tray.querySelector<HTMLButtonElement>('[data-wl-close]')!;
    const listEl = tray.querySelector<HTMLElement>('[data-wl-list]')!;
    const countEl = tray.querySelector<HTMLElement>('[data-wl-count]')!;
    const nudgeEl = tray.querySelector<HTMLElement>('[data-wl-nudge]')!;
    const liveEl = tray.querySelector<HTMLElement>('[data-wl-live]')!;
    const toastEl = tray.querySelector<HTMLElement>('[data-wl-toast]')!;

    function say(msg: string) {
      liveEl.textContent = msg;
    }
    /** A storage failure gets a VISIBLE message, not just a polite announcement.
     *  The whole point of the four-state toggle is that the user finds out. */
    function warn(msg: string) {
      toastEl.textContent = msg;
      toastEl.hidden = false;
      window.setTimeout(() => {
        toastEl.hidden = true;
      }, 7000);
      say(msg);
    }

    function render() {
      const items = getItems();
      countEl.textContent = String(items.length);
      tray.hidden = items.length === 0;
      if (items.length === 0) panel.hidden = true;

      const days = daysSinceExport();
      if (items.length === 0) {
        nudgeEl.hidden = true;
      } else if (days === null) {
        nudgeEl.hidden = false;
        nudgeEl.textContent =
          'Never exported. This list exists only in this browser — one bad day of storage eviction and it is gone.';
      } else if (days >= 7) {
        nudgeEl.hidden = false;
        nudgeEl.textContent = `Last exported ${days} days ago.`;
      } else {
        nudgeEl.hidden = true;
      }

      listEl.replaceChildren();
      for (const it of items) {
        const li = document.createElement('li');
        const live = published.has(it.id);

        if (live) {
          const a = document.createElement('a');
          a.href = `${dealBase}${encodeURIComponent(it.id)}/`;
          a.textContent = `${it.county} Co, ${it.state}`;
          li.appendChild(a);
          const s = document.createElement('span');
          s.className = 'wl-score num';
          s.textContent = it.score === null ? 'Not scored' : String(it.score);
          li.appendChild(s);
        } else {
          // NOT a dead link. The property left the published candidate set —
          // say which fact that is, and keep what we know about it.
          const span = document.createElement('span');
          span.className = 'wl-gone';
          span.textContent = `${it.county} Co, ${it.state}`;
          li.appendChild(span);
          const why = document.createElement('span');
          why.className = 'wl-why';
          why.textContent =
            it.score === null
              ? 'no longer in the published set — it was never scored'
              : `no longer scored — it left the published set (was ${it.score})`;
          li.appendChild(why);
        }

        const rm = document.createElement('button');
        rm.type = 'button';
        rm.className = 'wl-rm';
        rm.setAttribute('aria-label', `Remove ${it.county} County, ${it.state} from the watchlist`);
        rm.textContent = '✕';
        rm.addEventListener('click', () => {
          if (remove(it.id)) say('Removed.');
          else warn('This device refused the write — nothing was removed.');
        });
        li.appendChild(rm);
        listEl.appendChild(li);
      }
      syncButtons();
    }

    function syncButtons() {
      const items = new Set(getItems().map((i) => i.id));
      for (const b of document.querySelectorAll<HTMLButtonElement>('[data-watch-btn]')) {
        b.hidden = false; // reveal: this is the with-JS-only affordance
        const on = items.has(b.dataset.id || '');
        b.setAttribute('aria-pressed', String(on));
        const txt = b.querySelector('.wbtn__txt');
        if (txt) txt.textContent = on ? 'Watching' : 'Watch';
      }
    }

    // Delegated so cards rendered on any page are wired without per-card script.
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('[data-watch-btn]');
      if (!btn) return;
      const res = toggle({
        id: btn.dataset.id || '',
        county: btn.dataset.county || '',
        state: btn.dataset.stateCode || '',
        // '' is the wire spelling of unknown (WatchButton emits it for null).
        score: btn.dataset.score ? Number(btn.dataset.score) : null,
      });
      // All four states, distinctly. 'failed' is NOT 'removed'.
      if (res === 'added') say('Added to your watchlist.');
      else if (res === 'removed') say('Removed from your watchlist.');
      else if (res === 'full') warn(`Your watchlist is full (${count()} is the cap). Remove one first.`);
      else warn('This device refused the write — nothing was saved. Storage may be full, or this is a private window.');
    });

    openBtn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) closeBtn.focus();
    });
    closeBtn.addEventListener('click', () => {
      panel.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        openBtn.setAttribute('aria-expanded', 'false');
        openBtn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (panel.hidden) return;
      if (!tray.contains(e.target as Node)) {
        panel.hidden = true;
        openBtn.setAttribute('aria-expanded', 'false');
      }
    });

    tray.querySelector<HTMLButtonElement>('[data-wl-export]')?.addEventListener('click', () => {
      const payload = buildExport(getNotes());
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `blue-ridge-watchlist-${payload.exportedAt.slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      markExported();
      render();
      say(`Exported ${payload.watchlist.length} saved properties.`);
    });

    tray.querySelector<HTMLInputElement>('[data-wl-import]')?.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      file
        .text()
        .then((text) => {
          const r = importJson(text);
          if (!r.ok) {
            warn(r.error || 'Import failed — nothing was stored.');
            return;
          }
          const bits = [`${r.added} added`];
          if (r.duplicates) bits.push(`${r.duplicates} already saved`);
          if (r.capped) bits.push(`${r.capped} skipped (list full)`);
          if (r.notes) bits.push(`${r.notes} notes`);
          say(`Imported: ${bits.join(', ')}.`);
          render();
        })
        .catch(() => warn('That file could not be read.'))
        .finally(() => {
          input.value = '';
        });
    });

    tray.querySelector<HTMLButtonElement>('[data-wl-clear]')?.addEventListener('click', () => {
      // Destroys exactly what it claims to: the watchlist. Private notes live in
      // a separate store and are deliberately untouched.
      if (!window.confirm('Clear the whole watchlist? Your private notes are kept.')) return;
      if (clear()) say('Watchlist cleared.');
      else warn('This device refused the write — nothing was cleared.');
    });

    window.addEventListener(CHANGE_EVENT, render);
    render();
  })();
</script>

<style>
  .wl-tray {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    font-family: var(--font-ui);
  }
  .wl-tray[hidden] {
    display: none !important;
  }
  .wl-fab {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 44px;
    padding: 0.5em 1em;
    border-radius: 999px;
    border: var(--hairline) solid var(--accent);
    background: var(--accent);
    color: var(--accent-on);
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-m);
  }
  .wl-fab__n {
    background: var(--accent-on);
    color: var(--accent);
    border-radius: 999px;
    padding: 0 0.45em;
    min-width: 1.6em;
    text-align: center;
  }
  .wl-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.6rem);
    width: min(94vw, 24rem);
    max-height: min(70vh, 34rem);
    overflow: auto;
    background: var(--surface);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-l);
    padding: var(--space-s);
  }
  .wl-panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-2xs);
  }
  .wl-panel h2 {
    font-size: var(--step-1);
  }
  .wl-x {
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    font-size: var(--step-0);
    cursor: pointer;
    min-height: 34px;
    min-width: 34px;
  }
  .wl-nudge {
    font-size: var(--step--2);
    color: var(--warn);
    background: var(--warn-bg);
    border-radius: var(--radius-s);
    padding: 0.4rem 0.55rem;
    margin-bottom: var(--space-2xs);
    max-width: none;
  }
  .wl-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-s);
    display: grid;
    gap: 0.15rem;
    font-size: var(--step--1);
  }
  .wl-list li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.35rem 0;
    border-bottom: var(--hairline) dotted var(--rule);
  }
  .wl-list a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .wl-list a:hover {
    text-decoration: underline;
  }
  .wl-score {
    color: var(--ink-soft);
    font-size: var(--step--2);
  }
  .wl-gone {
    color: var(--ink-soft);
    text-decoration: line-through;
  }
  .wl-why {
    font-size: var(--step--2);
    color: var(--warn);
    flex: 1;
  }
  .wl-rm {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    min-height: 30px;
    min-width: 30px;
  }
  .wl-rm:hover {
    color: var(--warn);
  }
  .wl-acts {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .wl-import {
    cursor: pointer;
  }
  .wl-fine {
    font-size: var(--step--2);
    color: var(--ink-soft);
    margin-top: var(--space-2xs);
    max-width: none;
  }
  .wl-toast {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.6rem);
    width: min(94vw, 24rem);
    background: var(--warn-bg);
    color: var(--warn);
    border: var(--hairline) solid var(--warn);
    border-radius: var(--radius-s);
    padding: 0.5rem 0.7rem;
    font-size: var(--step--2);
    max-width: none;
    box-shadow: var(--shadow-m);
  }
  @media (max-width: 720px) {
    .wl-tray {
      right: auto;
      left: 1rem;
    }
    .wl-panel,
    .wl-toast {
      right: auto;
      left: 0;
    }
  }
</style>
