---
/**
 * A score is never a bare number here.
 *
 * Every render of a score carries, at minimum: the value, how many of the
 * signals were actually scored, and — one disclosure away on a card, inline on a
 * detail page — the per-signal contribution.
 *
 * The rule that makes it honest: an UNKNOWN signal is excluded from the
 * DENOMINATOR. It is never scored 0. "We don't know whether there's water" and
 * "there is definitely no water" are different facts, and a scoring system that
 * flattens them will confidently rank a county we can't see below a county we
 * can, which is precisely backwards.
 *
 * ── TWO FIXES IN THIS PASS ───────────────────────────────────────────────────
 *
 * 1. TN-ON-NC COPY. The old unscored message was one hardcoded sentence
 *    ("for East Tennessee that is structural: the state's parcel layer
 *    publishes no assessed value") shown on EVERY unscored card regardless of
 *    state. Measured 2026-08-19: 500 of 508 unscored cards are NORTH Carolina,
 *    where an assessed value IS published — those rows are unscored because no
 *    for-sale/distress evidence and no water/livability enrichment have
 *    reached them yet, a completely different fact from East Tennessee's
 *    structural gap, and the NC cards were citing someone else's reason. The
 *    caller now passes `assessedValueKnown` (a fact it already has) and the
 *    copy branches on THAT, not on a place name.
 *
 * 2. SCORE HIERARCHY. A score built from one signal at ~31% confidence is not
 *    a number worth leading with, however large the digit. When evidence is
 *    LOW, the confidence/fraction line is promoted ahead of the number and the
 *    number itself is shrunk and desaturated — demoted, not deleted; the value
 *    is still there for anyone who wants it, just not shouting.
 */
import type { ScoreBreakdown } from '../lib/types';
import { isLowEvidence } from '../lib/deals';

interface Props {
  /** `null` when NOTHING was measurable — not 0. See the null branch below. */
  score: number | null;
  breakdown: ScoreBreakdown;
  confidence?: number | undefined;
  variant?: 'card' | 'detail';
  /** Whether THIS record's assessed value is actually known. Gates the
   *  unscored explanation — see the file header. Defaults to `true` (the
   *  generic "not enriched yet" story) so a caller that forgets to pass it
   *  never falls back to the wrong hardcoded state-specific claim. */
  assessedValueKnown?: boolean;
}
const { score, breakdown, confidence, variant = 'card', assessedValueKnown = true } = Astro.props;

const scored = breakdown.signals.filter((s) => s.value !== null);
const unknown = breakdown.signals.filter((s) => s.value === null);
const total = breakdown.signals.length;
const low = isLowEvidence(breakdown);
/** Bucket 1..5 for the colour ramp. Colour is a hint; the number is the fact. */
const unscored = score === null;
// `data-band` drives the colour ramp; an unscored row gets its own band so it
// is visually off-ramp rather than painted as the lowest score.
const band = unscored ? 0 : Math.min(5, Math.max(1, Math.ceil(score / 20) || 1));

const contributions = scored
  .map((s) => ({
    ...s,
    /** Points this signal contributed to the final 0–100. */
    points: breakdown.denominator > 0
      ? Math.round(((s.weight * (s.value as number)) / breakdown.denominator) * 100)
      : 0,
    /** Points it COULD have contributed at value = 1. */
    ceiling: breakdown.denominator > 0 ? Math.round((s.weight / breakdown.denominator) * 100) : 0,
  }))
  .sort((a, b) => b.points - a.points);
---

<div class={`sm sm--${variant}`} data-band={band} data-low={!unscored && low ? 'true' : undefined}>
  <div class="sm__head">
    {/* ⛔ An unscored row must never render a bare blank where a number goes —
        that reads as a broken render, not as an honest absence. */}
    <span class="sm__val num" aria-hidden="true">{unscored ? '—' : score}</span>
    <span class="visually-hidden">
      {unscored
        ? 'Not scored: none of the signals could be measured for this parcel.'
        : `Score ${score} out of 100.`}
    </span>
    <span class="sm__of">
      {/* A 0-width bar for an unscored row would look identical to a genuine
          score of 0 — the exact confusion this whole change removes. */}
      <span class="sm__bar" aria-hidden="true">
        {!unscored && <span style={`width:${score}%`}></span>}
      </span>
      <span class="sm__meta">
        {!unscored && low && <strong class="sm__lowtag">Low evidence</strong>}
        {!unscored && low && ' · '}
        {unscored
          ? 'not scored — no signal could be measured'
          : <>scored from <strong class="num">{scored.length}</strong> of <strong class="num">{total}</strong> signals</>}
        {confidence !== undefined && <> · confidence <strong class="num">{Math.round(confidence * 100)}%</strong></>}
      </span>
    </span>
  </div>

  {
    unscored && (
      <p class="sm__low">
        {
          assessedValueKnown === false ? (
            <>
              Not scored. Every signal is unknown for this parcel, and that is structural here: this
              county's parcel layer publishes no assessed value, so discount and $/acre have no input
              at all. This is not a low score; it is the absence of one.
            </>
          ) : (
            <>
              Not scored. This parcel has an assessed value, but no for-sale/distress evidence and no
              water/livability enrichment have been joined to it yet — that pass has not reached this
              parcel. This is not a low score; it is the absence of one.
            </>
          )
        }
      </p>
    )
  }

  {
    !unscored && low && (
      <p class="sm__low">
        Low evidence — {unknown.length} of {total} signals are unknown for this parcel. The score is
        computed only over what is known; it is not a claim that the unknown parts are bad.
      </p>
    )
  }

  {
    variant === 'card' ? (
      <details class="sm__why">
        <summary>Why this score?</summary>
        <ul class="sm__list">
          {contributions.map((s) => (
            <li>
              <span class="sm__k">{s.label}</span>
              <span class="sm__pts num">
                +{s.points}
                <span class="sm__ceil"> / {s.ceiling}</span>
              </span>
            </li>
          ))}
          {unknown.map((s) => (
            <li class="sm__unk">
              <span class="sm__k">{s.label}</span>
              <span class="sm__pts">unknown — excluded</span>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <table class="tbl sm__tbl">
        <caption>
          Every signal, its weight, and what it contributed. Unknown signals are excluded from the
          denominator ({breakdown.denominator} of{' '}
          {breakdown.signals.reduce((a, s) => a + s.weight, 0)} total weight), never scored zero.
        </caption>
        <thead>
          <tr>
            <th scope="col">Signal</th>
            <th scope="col">Reading</th>
            <th scope="col" class="num">Weight</th>
            <th scope="col" class="num">Points</th>
          </tr>
        </thead>
        <tbody>
          {contributions.map((s) => (
            <tr>
              <th scope="row">{s.label}</th>
              <td>{s.note}</td>
              <td class="num">{s.weight}</td>
              <td class="num">
                +{s.points} <span class="sm__ceil">/ {s.ceiling}</span>
              </td>
            </tr>
          ))}
          {unknown.map((s) => (
            <tr class="sm__unk">
              <th scope="row">{s.label}</th>
              <td>{s.note}</td>
              <td class="num">
                <span class="sm__strike">{s.weight}</span>
              </td>
              <td>unknown — excluded</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</div>

<style>
  .sm {
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
  .sm__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sm__val {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    font-weight: 600;
    color: var(--score-5);
    min-width: 2ch;
    text-align: right;
    order: 1;
  }
  [data-band='1'] .sm__val { color: var(--score-1); }
  [data-band='2'] .sm__val { color: var(--score-2); }
  [data-band='3'] .sm__val { color: var(--score-3); }
  [data-band='4'] .sm__val { color: var(--score-4); }
  [data-band='5'] .sm__val { color: var(--score-5); }
  /* Band 0 = unscored. It is OFF the ramp, not the bottom of it — without this
     rule it fell through to the base `.sm__val` colour (`--score-5`, the
     STRONGEST stop), so the "—" for a parcel nothing could be measured for
     rendered in the boldest, most confident colour on the entire ramp. Same
     desaturated grey the map already uses for the same state. */
  [data-band='0'] .sm__val {
    color: var(--score-unknown);
  }
  /* Bands 1–2 are pale by design; on the light theme they need a darker ink to
     stay legible as TEXT, so the ramp only drives the bar there. */
  :root:not([data-theme='hollow']) [data-band='1'] .sm__val,
  :root:not([data-theme='hollow']) [data-band='2'] .sm__val {
    color: var(--ink-soft);
  }
  .sm__of {
    display: grid;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
    order: 2;
  }
  .sm__bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--band);
    overflow: hidden;
  }
  .sm__bar > span {
    display: block;
    height: 100%;
    background: var(--score-4);
    border-radius: 999px;
  }
  [data-band='1'] .sm__bar > span { background: var(--score-1); }
  [data-band='2'] .sm__bar > span { background: var(--score-2); }
  [data-band='3'] .sm__bar > span { background: var(--score-3); }
  [data-band='4'] .sm__bar > span { background: var(--score-4); }
  [data-band='5'] .sm__bar > span { background: var(--score-5); }
  .sm__meta {
    font-size: var(--step--2);
    color: var(--ink-soft);
  }
  .sm__meta strong {
    color: var(--ink);
  }
  .sm__lowtag {
    color: var(--warn);
  }

  /* ── SCORE HIERARCHY — demote the number under the confidence line when
     evidence is thin (`data-low`). `order` (not `flex-direction: row-reverse`,
     which would also flip alignment) swaps which element leads visually
     without touching the LTR reading order of either child's own content. The
     number shrinks and loses its ramp colour: still present, no longer the
     first or loudest thing on the card. Selector specificity — one extra
     attribute selector — beats the `[data-band='N']` colour rules above
     regardless of source order, so this does not need `!important`. */
  .sm[data-low='true'] .sm__val {
    order: 2;
    font-size: var(--step-1);
    color: var(--ink-soft);
    text-align: left;
  }
  .sm[data-low='true'] .sm__of {
    order: 1;
  }
  .sm[data-low='true'] .sm__bar {
    opacity: 0.6;
  }

  .sm__low {
    margin-top: 0.45rem;
    font-size: var(--step--2);
    color: var(--warn);
    background: var(--warn-bg);
    border-radius: var(--radius-s);
    padding: 0.35rem 0.55rem;
    max-width: none;
  }
  .sm__why {
    margin-top: 0.5rem;
  }
  .sm__why summary {
    cursor: pointer;
    font-size: var(--step--2);
    color: var(--accent);
    font-weight: 600;
  }
  .sm__list {
    list-style: none;
    padding: 0.4rem 0 0;
    margin: 0;
    display: grid;
    gap: 0.2rem;
    font-size: var(--step--2);
  }
  .sm__list li {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    border-bottom: var(--hairline) dotted var(--rule);
    padding-bottom: 0.15rem;
  }
  .sm__k {
    color: var(--ink-soft);
  }
  .sm__pts {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }
  .sm__ceil {
    color: var(--ink-soft);
    font-weight: 400;
  }
  .sm__unk .sm__pts,
  .sm__unk td {
    color: var(--ink-soft);
    font-style: italic;
    font-weight: 400;
  }
  .sm__strike {
    text-decoration: line-through;
    color: var(--ink-soft);
  }
  .sm__tbl {
    margin-top: var(--space-s);
  }
  .sm__tbl caption {
    max-width: 74ch;
  }
</style>
